# Copie para .env e preencha. NÃO commite o .env real.

# Database (docker-compose em infra/ sobe esse Postgres)
DATABASE_URL=postgresql://jobspark:jobspark123@localhost:5432/jobspark_dev
PORT=3002

# Redis
REDIS_URL=redis://localhost:6379

# IA — Groq (https://console.groq.com/keys). LLM: análise de currículo + match.
# Vazio/"mock_key_for_now" = LLM em modo mock.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings — Google Generative Language API (https://aistudio.google.com/app/apikey).
# Modelo gemini-embedding-001 a 768d. Se vazio, usa embedding local determinístico.
GOOGLE_AI_API_KEY=
GOOGLE_EMBED_MODEL=gemini-embedding-001

# Auth — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
BETTER_AUTH_SECRET=

# Cloudflare R2 (upload de currículos) — opcional na demo
R2_BUCKET_NAME=jobspark-uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_APP_URL=http://localhost:3000
