generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ============ ENUMS ============

enum Role {
  CANDIDATE
  COMPANY
  RECRUITER
  ADMIN
}

enum CompanySize {
  STARTUP
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum Plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum WorkType {
  FULL_TIME
  PART_TIME
  FREELANCE
  INTERNSHIP
}

enum WorkplaceType {
  ONSITE
  REMOTE
  HYBRID
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  VIEWED
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

// ============ MODELS ============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  avatarUrl    String?
  role         Role     @default(CANDIDATE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidate Candidate?
  company   Company?
  recruiter Recruiter?
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Candidate {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String?
  bio             String?
  resumeUrl       String?
  linkedinUrl     String?
  githubUrl       String?
  portfolioUrl    String?
  skills          String[]
  experienceYears Int     @default(0)
  salaryExpected  Int?
  city            String?
  state           String?
  workplaceTypes  WorkplaceType[]
  aiScore         Float?
  aiAnalysis      Json?
  embedding       Unsupported("vector(768)")?
  isPublic        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications Application[]
  savedJobs    SavedJob[]
  
  @@index([skills], type: Gin)
}

model Company {
  id          String      @id @default(cuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  cnpj        String      @unique
  logoUrl     String?
  website     String?
  sector      String?
  size        CompanySize @default(STARTUP)
  description String?
  plan        Plan        @default(FREE)
  isVerified  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  jobs Job[]
}

model Recruiter {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  createdAt DateTime @default(now())
}

model Job {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  description   String
  requirements  String[]
  skills        String[]
  benefits      String[]
  workType      WorkType      @default(FULL_TIME)
  workplaceType WorkplaceType @default(HYBRID)
  location      String?
  salaryMin     Int?
  salaryMax     Int?
  salaryCurrency String @default("BRL")
  status        JobStatus     @default(DRAFT)
  featured      Boolean       @default(false)
  viewCount     Int           @default(0)
  embedding     Unsupported("vector(768)")?
  aiAnalysis    Json?
  expiresAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  applications  Application[]
  savedBy       SavedJob[]

  @@index([status, createdAt])
  @@index([skills], type: Gin)
  @@index([companyId])
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(APPLIED)
  matchScore  Float?
  coverLetter String?
  feedback    String?
  notes       String?           // notas internas da empresa
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, candidateId])
  @@index([status])
  @@index([candidateId])
  @@index([jobId])
}

model SavedJob {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([candidateId, jobId])
}
